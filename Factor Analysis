{r setup, include=FALSE}
#Chunk 1
#Loading every session
library(purrr)
library(tidyr)
library(tidyverse)
library(ggplot2)
library(factoextra)
library(GPArotation)
library(broom)
library(psych)
library(cluster)
library(RColorBrewer)
library(ggdendro)
library(corrplot)
library(dunn.test)

#read data
death<-read_csv("C:/Users/RALPH/Downloads/Data/death.csv")

# Pivot to wide format: rows = community areas,
# cols = specific causes of death
wide <- death %>%
  filter(
    !`Cause of Death` %in% c("All Causes","All causes in males","All causes in females"),
    !`Community Area Name` %in% "Chicago"
  ) %>%
  select(`Community Area Name`, `Cause of Death`, `Average Adjusted Rate 2006 - 2010`) %>%

  # ── Fix the two mismatched names HERE, at the source ─────────────────
  mutate(`Community Area Name` = recode(`Community Area Name`,
    "Montclaire"    = "Montclare",    # remove extra 'i'
    "Humboldt park" = "Humboldt Park",
    "Mckinley"      = "McKinley",
    "O'hare"        = "O'Hare" 
  )) %>%
  
  pivot_wider(
    names_from  = `Cause of Death`,
    values_from = `Average Adjusted Rate 2006 - 2010`
  )

#Separate the ID column from numeric data
X <- wide %>% select(-`Community Area Name`)


#chunk 2
#Testing if the data is fit for Factor Analysis
#Adequacy Test
#KMO test
kmo_result <- KMO(X)
print(kmo_result)
# Look at: Overall MSA (should be > 0.80)

# Bartlett's test of sphericity
bartlett_result <- cortest.bartlett(cor(X), n = nrow(X))
print(bartlett_result)
# Look at: p.value (should be < 0.05)


#chunk 3
# PCA on scaled data (uses correlation matrix)
pca_init <- prcomp(X, scale. = TRUE)

# Eigenvalues = variance of each principal component
eigenvalues <- pca_init$sdev^2
print(round(eigenvalues, 3))

# How many are > 1?
sum(eigenvalues > 1)  # Kaiser criterion -> 4

# Scree plot
fviz_eig(pca_init,
         addlabels = TRUE,
         ncp       = 10,
         main      = "Scree plot — eigenvalues") +
geom_hline(yintercept = 1,
             linetype   = "dashed",
             colour     = "red")

# Cumulative variance explained
cumsum(eigenvalues / sum(eigenvalues))


#chunk 4
# ── Step 1: Run PAF ─────────────────────────────────────────────────
fa_result <- fa(
  r         = X,
  nfactors  = 5,
  rotate    = "varimax",
  fm        = "pa",
  scores    = "regression",
  n.obs     = nrow(X)
)

# ── Step 2: Print loadings BEFORE any renaming ──────────────────────
print(fa_result$loadings, cutoff = 0.30, sort = TRUE)
cat("\nVariance explained per factor:\n")
print(fa_result$Vaccounted)

# ── Step 3: Communalities — MUST happen before colnames() rename ────
# Save variable names directly from the original rownames
var_names <- rownames(fa_result$loadings)

# ── Communalities — computed directly from uniquenesses ───────────────
# fa_result$communalities is returning a scalar (bug in this psych version)
# h² = 1 - u²  is mathematically identical and always correct

comm_df <- data.frame(
  Variable = names(fa_result$uniquenesses),          # names are here, not communalities
  u2       = round(as.numeric(fa_result$uniquenesses), 3),
  h2       = round(1 - as.numeric(fa_result$uniquenesses), 3),  # derive h² from u²
  stringsAsFactors = FALSE
) %>%
  arrange(desc(h2))

print(comm_df)

# ── Step 4: Factor scores with proper column names ──────────────────
# ── Factor scores — single clean block ────────────────────────────────

# Extract scores and rename columns immediately in one step
factor_scores <- as.data.frame(fa_result$scores) %>%
  setNames(c(
    "F1_UrbanBurden",
    "F2_AgeSexCancers",
    "F3_LifestyleOrgan",
    "F4_MetabolicVascular",
    "F5_UnintenInjury"
  )) %>%
  mutate(area = wide$`Community Area Name`)

# Verify columns are named correctly before printing
print(head(factor_scores))
# Save
write_csv(factor_scores, "factor_scores_paf5.csv")

# ── Step 5: NOW rename loadings columns ────────────────────────────
# This comes LAST because it destroys rownames
colnames(fa_result$loadings) <- c(
  "F1_UrbanBurden", "F2_AgeSexCancers",
  "F3_LifestyleOrgan", "F4_MetabolicVascular",
  "F5_UnintenInjury"
)


# ── Step 6: Diagnostics ────────────────────────────────────────────
round(cor(fa_result$scores), 3)

fa.diagram(fa_result, cut = 0.40,
           main = "Factor diagram (|loading| > 0.40)")

reproduced <- fa_result$loadings %*% t(fa_result$loadings)
residuals  <- cor(X) - reproduced
cat("\nMax residual:", round(max(abs(residuals)), 4))
cat("\nRMSR:", round(sqrt(mean(residuals^2)), 4))

# ── Step 7: Session summary ────────────────────────────────────────
cat("N factors retained:", fa_result$factors, "\n")   # reads from model, not hardcoded
cat("Variance explained:", round(sum(fa_result$Vaccounted[2,]) * 100, 1), "%\n")

# ── Step 8: Save ───────────────────────────────────────────────────
write_csv(comm_df,       "communalities_paf5.csv")
write_csv(factor_scores, "factor_scores_paf5.csv")
write_csv(
  as.data.frame(unclass(fa_result$loadings)) %>%
    rownames_to_column("variable"),
  "factor_loadings_paf5.csv"
)


#chunk 4
# ── 1. Factor scores — attach names FIRST ─────────────────────────────
scores_mat <- fa_result$scores
rownames(scores_mat) <- wide$`Community Area Name`   

# ── 2. Distance and clustering ────────────────────────────────────────
dist_mat <- dist(scores_mat, method = "euclidean")^2
hc       <- hclust(dist_mat, method = "ward.D")

# ── 3. Dendrogram ─────────────────────────────────────────────────────
plot(hc,
     cex  = 0.6,
     main = "Ward dendrogram — Chicago community areas",
     xlab = "", sub = "")
rect.hclust(hc, k = 6, border = c(
  "green3","steelblue","purple","orange","coral","red"))

# ── 4. Gap statistic ──────────────────────────────────────────────────
set.seed(42)
gap_stat <- clusGap(scores_mat,
                    FUN       = hcut,
                    K.max     = 10,
                    B         = 50,
                    hc_method = "ward.D")
fviz_gap_stat(gap_stat)

# ── 5. Cut tree ───────────────────────────────────────────────────────
cluster_labels <- cutree(hc, k = 6)

# ── 6. Verify names attached correctly ───────────────────────────────
head(names(cluster_labels)) 
table(cluster_labels)


#chunk 5
# Add cluster labels to original wide data
X_clustered <- X
X_clustered$cluster <- cluster_labels
X_clustered$Community_Area <- wide$`Community Area Name`

# Cluster means for each variable
cluster_means <- X_clustered %>%
group_by(cluster) %>%
summarise(across(where(is.numeric), mean, .names = "{.col}")) %>%
column_to_rownames("cluster")

print(round(t(cluster_means), 1))

# Cluster membership list
X_clustered %>%
 group_by(cluster) %>%
  summarise(
    n        = n(),
    areas    = paste(Community_Area, collapse = ", ")
  ) %>%
 print(width = Inf)

# Heatmap of cluster means
library(pheatmap)
pheatmap(t(scale(cluster_means)),
         cluster_rows = FALSE,
         cluster_cols = FALSE,
         main         = "Cluster means (scaled)",
         color        = colorRampPalette(
           c("#185FA5","white","#D85A30"))(50))


#chunk 6
# Kruskal-Wallis for each variable
kw_results <- X_clustered %>%
 select(-Community_Area) %>%
  pivot_longer(-cluster,
               names_to  = "variable",
               values_to = "value") %>%
  group_by(variable) %>%
  summarise(
    H      = kruskal.test(value ~ factor(cluster))$statistic,
    df     = kruskal.test(value ~ factor(cluster))$parameter,
    p_val  = kruskal.test(value ~ factor(cluster))$p.value,
    .groups = "drop"
  ) %>%
  mutate(
    sig    = case_when(p_val < 0.001 ~ "***",
                       p_val < 0.01  ~ "**",
                       p_val < 0.05  ~ "*",
                       TRUE          ~ "ns"),
    eta_sq = (H - df) / (nrow(X_clustered) - 1)
  ) %>%
  arrange(p_val)

print(kw_results, n = Inf)


#chunk 7
# Run pairwise tests for one variable example
dunn.test(
  x              = X_clustered$`Assault (homicide)`,
  g              = X_clustered$cluster,
  method         = "bonferroni",
  kw             = TRUE,
  label          = TRUE,
  table          = TRUE
)

# Loop over all variables
vars_to_test <- names(X)

pairwise_results <- map(vars_to_test, function(v) {
  test <- dunn.test(
    x      = X_clustered[[v]],
    g      = X_clustered$cluster,
    method = "bonferroni",
    kw     = FALSE,
    altp   = TRUE
  )
  tibble(
    variable = v,
    comparison = test$comparisons,
    Z          = test$Z,
    p_adj      = test$altP.adjusted,
    sig        = p_adj < 0.05
  )
}) %>% bind_rows()

# Filter to significant pairs only
pairwise_results %>%
 filter(sig) %>%
 arrange(variable, comparison) %>%
 print(n = 50)


