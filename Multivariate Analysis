  cat(sprintf("μ_ahies1_%d - μ_ahies2_%d  (%-10s): %7.4f ± %.4f → [%7.4f, %7.4f]  Sig: %s\n",
              i,i,var_names[i],est,hw,lo,hi,sig))
  ci_df <- rbind(ci_df,
                 data.frame(Component=var_names[i],
                            Estimate=est, Lower=lo, Upper=hi, Sig=sig))
}


