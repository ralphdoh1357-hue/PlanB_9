for (var in vars) {
  
  orig_pval  <- summary_stats$SW_pvalue[summary_stats$Variable == var]
  is_normal  <- orig_pval >= 0.05
  
  if (!is_normal) {
    
    x <- ahies[[var]]
    cat("\n", strrep("─", 55), "\n")
