# FUNCTION: Two-sample Hotelling T² analysis
hotelling_two_sample <- function(grp1, grp2, alpha=0.01,
                                  label1="Group1", label2="Group2",
                                  show_details=TRUE) {
  n1 <- nrow(grp1); n2 <- nrow(grp2); p <- ncol(grp1)

  x1  <- colMeans(grp1);  x2  <- colMeans(grp2)
  S1  <- cov(grp1);       S2  <- cov(grp2)
  d   <- x1 - x2

  # Pooled covariance
  Sp  <- ((n1-1)*S1 + (n2-1)*S2) / (n1+n2-2)

  # T² statistic
  T2  <- as.numeric(t(d) %*% solve((1/n1+1/n2)*Sp) %*% d)

  # Critical value & F-stat
  df1    <- p
  df2    <- n1+n2-p-1
  F_crit <- qf(alpha, df1, df2, lower.tail=FALSE)
  crit   <- p*(n1+n2-2)/(n1+n2-p-1) * F_crit
  F_stat <- (n1+n2-p-1)/(p*(n1+n2-2)) * T2
  p_val  <- pf(F_stat, df1, df2, lower.tail=FALSE)

  if (show_details) {
    cat(sprintf("\n%s (n=%d)  vs  %s (n=%d)\n",label1,n1,label2,n2))
    cat(sprintf("  %-12s  %s\n","","BMI   Edu_Expenses  Income"))
    cat(sprintf("  %-12s  %.4f  %.4f  %.4f\n",
                paste0("x̄(",label1,")"), x1[1],x1[2],x1[3]))
    cat(sprintf("  %-12s  %.4f  %.4f  %.4f\n",
                paste0("x̄(",label2,")"), x2[1],x2[2],x2[3]))
    cat(sprintf("  %-12s  %.4f  %.4f  %.4f\n",
                "Difference", d[1],d[2],d[3]))
    cat(sprintf("\n  T² statistic    : %.4f\n", T2))
    cat(sprintf("  Critical c²     : %.4f\n", crit))
    cat(sprintf("  F-statistic     : %.4f\n", F_stat))
    cat(sprintf("  df              : (%d, %d)\n", df1, df2))
    cat(sprintf("  P-value         : %.6f\n", p_val))
    cat(sprintf("  Decision        : %s H0 at α=%.2f\n",
                ifelse(p_val<alpha,"REJECT","FAIL TO REJECT"), alpha))
  }

  list(x1=x1, x2=x2, d=d, Sp=Sp, S1=S1, S2=S2,
       T2=T2, crit=crit, F_stat=F_stat, p_val=p_val,
       n1=n1, n2=n2, p=p, alpha=alpha, df1=df1, df2=df2)
}

