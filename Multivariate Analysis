      Transformed_pvalue    = best$pvalue,
      Skewness_Original     = round(skewness(x,            na.rm = TRUE), 3),
      Skewness_Transformed  = round(skewness(best$x_trans, na.rm = TRUE), 3)
    ))
    
  } else {
    cat("\nVariable:", var, "— already normal (p =",
        round(orig_pval, 4), ") — no transformation needed\n")
  }
}

