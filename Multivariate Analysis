# One-Way MANOVA - Three Response Variables, Two Treatments

# Data Entry 
trt1 <- ahies_1
trt2 <- ahies_2          

# Combine with group labels
data_all <- rbind(trt1, trt2)
group    <- factor(c(rep(1, nrow(trt1)),
                     rep(2, nrow(trt2))
                     ))

colnames(data_all) <- c("Y1", "Y2", "Y3")
df <- data.frame(data_all, Treatment = group)

#cat("Full Dataset:\n"); print(df)

g <- 2                          # number of treatments
n <- c(nrow(trt1), nrow(trt2))   # n1=1424, n2=1430
N <- sum(n)                     # total observations = 2854
p <- 3                          # number of response variables

# (a) DECOMPOSITION: Mean + Treatment + Residual  
# Overall mean
x_grand <- colMeans(data_all)

# Treatment means
x_trt <- rbind(colMeans(trt1),
               colMeans(trt2)
               )
rownames(x_trt) <- paste("Treatment", 1:g)
colnames(x_trt) <- c("Y1", "Y2", "Y3")

cat("\n── Overall Grand Mean \n")
print(round(x_grand, 4))

cat("\n── Treatment Means \n")
print(round(x_trt, 4))

# Build decomposition arrays observation by observation
cat("\n── Decomposition: x_lj = x̄ + (x̄_l - x̄) + (x_lj - x̄_l) ──\n\n")

treatments <- list(trt1, trt2)

for (l in 1:g) {
  for (j in 1:n[l]) {
    obs <- treatments[[l]][j, ]
    res <- obs - x_trt[l, ]
  }
}

# (b) ONE-WAY MANOVA TABLE  [SS&CP Matrices]
# Between-treatment SS&CP matrix B
B <- matrix(0, p, p)                        
for (l in 1:g) {
  d <- matrix(x_trt[l,] - x_grand, ncol=1)
  D <- as.numeric(d)
  B <- B + n[l] * (D %*% t(D))
}

# Within-treatment (Residual/Error) SS&CP matrix W
W <- matrix(0, p, p)                        
for (l in 1:g) {
  for (j in 1:n[l]) {
    d <- matrix(treatments[[l]][j,] - x_trt[l,], ncol=1)
    D <- as.numeric(d)
    W <-(W + D %*% t(D))
  }
}

# Total SS&CP matrix
Total_SS <- B + W

cat("── Between-Treatment SS&CP Matrix (B) ─\n")
print(round(B, 4))

cat("\n── Within-Treatment SS&CP Matrix (W) ─\n")
print(round(W, 4))

cat("\n── Total SS&CP Matrix (B + W) ─\n")
print(round(Total_SS, 4))

# Degrees of freedom
df_trt   <- g - 1        # between:  g-1 = 1
df_error <- N - g        # within:   N-g = 2852
df_total <- N - 1        # total:    N-1 = 2853  

cat("\n── MANOVA Table ─\n")
cat(sprintf("%-20s  df = %d\n", "Treatment (Between):", df_trt))
cat(sprintf("%-20s  df = %d\n", "Residual (Within):",   df_error))
cat(sprintf("%-20s  df = %d\n", "Total:",               df_total))
cat("\nB (Treatment SS&CP):\n");   print(round(B, 4))
cat("\nW (Residual SS&CP):\n");    print(round(W, 4))

# (c) WILKS' LAMBDA  
Lambda_star <- det(W) / det(B + W)
cat("\n── Wilks' Lambda ──\n")
cat(sprintf("Λ* = |W| / |B+W| = %.6f / %.6f = %.6f\n",
            det(W), det(B+W), Lambda_star))

# Exact F-test for g=2, p=3   
# When g=2: F = [(1-Λ*)/Λ*] * [(N-p-1)/p]
alpha <- 0.05

num_df   <- p                    # 3
denom_df <- (N - p - 1)          # 2850

# Exact: [(1 - Λ*) / Λ*] * [(N-p-1)/p]
F_exact <- ((1 - Lambda_star) / Lambda_star) * ((N - p - 1) / p)
F_crit  <- qf(alpha, df1 = num_df, df2 = denom_df, lower.tail = FALSE)
p_exact <- pf(F_exact, df1 = num_df, df2 = denom_df, lower.tail = FALSE)

cat(sprintf("\nExact F-test (g=2 transformation):\n"))
cat(sprintf("  F-statistic = %.4f\n", F_exact))
cat(sprintf("  df = (%d, %d)\n", num_df, denom_df))
cat(sprintf("  Critical value F(0.05; %d, %d) = %.4f\n", num_df, denom_df, F_crit))
cat(sprintf("  P-value = %.6f\n", p_exact))

if (p_exact < alpha) {
  cat(sprintf("\n  Decision: REJECT H0 at α = %.2f\n", alpha))
  cat("  → Significant treatment effects exist.\n")
} else {
  cat(sprintf("\n  Decision: FAIL TO REJECT H0 at α = %.2f\n", alpha))
}

# ── Comparison Summary ─                             
cat("\nSUMMARY COMPARISON\n")
cat(sprintf("  Wilks' Lambda (Λ*)          : %.6f\n", Lambda_star))
cat(sprintf("  Exact F-test p-value        : %.6f  → %s\n",
            p_exact, ifelse(p_exact < alpha, "REJECT H0", "FAIL TO REJECT")))

