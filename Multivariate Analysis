# ── Helper: pick the best transformation by highest Shapiro-Wilk p-value ──────

try_all_transformations <- function(x, var_name) {
  
  results <- list()
  
  # ── 0. Shift to positive if needed ─────────────────────────────────────────
  x_pos <- x
  shift  <- 0
  if (min(x, na.rm = TRUE) <= 0) {
    shift  <- abs(min(x, na.rm = TRUE)) + 1
    x_pos  <- x + shift
  }
  
  # ── 1. Log transformation  (for right-skewed, strictly positive) ────────────
  tryCatch({
    x_log <- log(x_pos)
    sw    <- shapiro.test(x_log)
    results[["Log"]] <- list(
      x_trans  = x_log,
      name     = ifelse(shift > 0,
                        paste0("log(x + ", round(shift,2), ")"),
                        "log(x)"),
      lambda   = NA_real_,
      pvalue   = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 2. Square-root transformation  (moderate right skew, non-negative) ──────
  tryCatch({
    x_sqrt <- sqrt(x_pos)
    sw     <- shapiro.test(x_sqrt)
    results[["Sqrt"]] <- list(
      x_trans = x_sqrt,
      name    = ifelse(shift > 0,
                       paste0("sqrt(x + ", round(shift,2), ")"),
                       "sqrt(x)"),
      lambda  = 0.5,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 3. Cube-root transformation  (handles zero & negative values) ────────────
  tryCatch({
    x_cbrt <- sign(x) * abs(x)^(1/3)
    sw     <- shapiro.test(x_cbrt)
    results[["Cube_Root"]] <- list(
      x_trans = x_cbrt,
      name    = "cbrt(x)",
      lambda  = 1/3,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 4. Reciprocal (1/x)  (severe right skew) ────────────────────────────────
  tryCatch({
    x_rec <- 1 / x_pos
    sw    <- shapiro.test(x_rec)
    results[["Reciprocal"]] <- list(
      x_trans = x_rec,
      name    = ifelse(shift > 0,
                       paste0("1/(x + ", round(shift,2), ")"),
                       "1/x"),
      lambda  = -1,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 5. Square transformation  (left-skewed data) ────────────────────────────
  tryCatch({
    x_sq <- x^2
    sw   <- shapiro.test(x_sq)
    results[["Square"]] <- list(
      x_trans = x_sq,
      name    = "x^2",
      lambda  = 2,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 6. Box-Cox transformation  (optimal lambda, strictly positive) ───────────
  tryCatch({
    bc         <- boxcox(lm(x_pos ~ 1), lambda = seq(-3, 3, 0.05), plotit = FALSE)
    lambda_opt <- bc$x[which.max(bc$y)]
    
    x_bc <- if (abs(lambda_opt) < 0.01) {
      log(x_pos)
    } else {
      (x_pos^lambda_opt - 1) / lambda_opt
    }
    
    sw <- shapiro.test(x_bc)
    results[["Box_Cox"]] <- list(
      x_trans = x_bc,
      name    = ifelse(abs(lambda_opt) < 0.01,
                       "Box-Cox: log",
                       paste0("Box-Cox(λ=", round(lambda_opt, 2), ")")),
      lambda  = lambda_opt,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 7. Yeo-Johnson transformation  (works with negative values too) ──────────
  tryCatch({
    yj_obj  <- powerTransform(x ~ 1, family = "yjPower")
    lam_yj  <- coef(yj_obj, round = FALSE)
    x_yj    <- yjPower(x, lambda = lam_yj)
    sw      <- shapiro.test(x_yj)
    results[["Yeo_Johnson"]] <- list(
      x_trans = x_yj,
      name    = paste0("Yeo-Johnson(λ=", round(lam_yj, 2), ")"),
      lambda  = lam_yj,
      pvalue  = sw$p.value
    )
  }, error = function(e) NULL)
  
  # ── 8. Arcsine-square-root  (proportions / percentages in [0,1]) ─────────────
  tryCatch({
    if (max(x, na.rm = TRUE) <= 1 && min(x, na.rm = TRUE) >= 0) {
      x_asin <- asin(sqrt(x))
      sw     <- shapiro.test(x_asin)
      results[["Arcsine"]] <- list(
        x_trans = x_asin,
        name    = "asin(sqrt(x))",
        lambda  = NA_real_,
        pvalue  = sw$p.value
      )
    }
  }, error = function(e) NULL)
  
  # ── 9. Logit transformation  (proportions strictly in (0,1)) ────────────────
  tryCatch({
    if (max(x, na.rm = TRUE) < 1 && min(x, na.rm = TRUE) > 0) {
      x_logit <- log(x / (1 - x))
      sw      <- shapiro.test(x_logit)
      results[["Logit"]] <- list(
        x_trans = x_logit,
        name    = "logit(x)",
        lambda  = NA_real_,
        pvalue  = sw$p.value
      )
    }
  }, error = function(e) NULL)
  
  # ── 10. Negative log  (left-skewed, positive values) ────────────────────────
  tryCatch({
    if (skewness(x, na.rm = TRUE) < -0.5) {
      x_neglog <- -log(max(x_pos, na.rm = TRUE) + 1 - x_pos)
      sw       <- shapiro.test(x_neglog)
      results[["Neg_Log"]] <- list(
        x_trans = x_neglog,
        name    = "-log(max-x+1)",
        lambda  = NA_real_,
        pvalue  = sw$p.value
      )
    }
  }, error = function(e) NULL)
  
  return(results)
}

