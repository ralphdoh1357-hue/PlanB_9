    cat("Original Shapiro-Wilk p-value:", round(orig_pval, 4), "\n")
    cat("Skewness:", round(skewness(x, na.rm = TRUE), 3), "\n\n")
    
    # Try every transformation
    all_results <- try_all_transformations(x, var)
    
    if (length(all_results) == 0) {
      cat("  ⚠ No transformations succeeded for", var, "\n")
      next
    }
    
    # Print results table for all transformations tried
    cat(sprintf("  %-30s %10s\n", "Transformation", "SW p-value"))
    cat("  ", strrep("-", 42), "\n", sep = "")
    for (nm in names(all_results)) {
      cat(sprintf("  %-30s %10.4f%s\n",
                  all_results[[nm]]$name,
                  all_results[[nm]]$pvalue,
                  ifelse(all_results[[nm]]$pvalue >= 0.05, "  ✔ NORMAL", "")))
    }
    
    # ── Select best transformation ─────────────────────────────────────────
    best_name <- names(which.max(sapply(all_results, `[[`, "pvalue")))
    best      <- all_results[[best_name]]
    
    cat("\n  ★ Best transformation:", best$name,
        "  (p =", round(best$pvalue, 4), ")\n")
    
    # Apply best transformation to the data frame
    transformed_data[[var]] <- best$x_trans
    
    # ── QQ plots: original vs best ─────────────────────────────────────────
    par(mfrow = c(1, 2))
    qqnorm(x,             main = paste("Original:", var));      qqline(x,             col = "red")
    qqnorm(best$x_trans,  main = paste(best$name));             qqline(best$x_trans,  col = "blue")
    
    # ── Log transformation details ─────────────────────────────────────────
    transformation_log <- rbind(transformation_log, data.frame(
      Variable              = var,
      Best_Transformation   = best$name,
      Lambda                = ifelse(is.null(best$lambda) || is.na(best$lambda),
                                     NA_real_, best$lambda),
